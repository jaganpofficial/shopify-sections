      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Display Duration",
      "default": 4
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Margin",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 15,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 15,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (Optional)"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "FREE SHIPPING"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text Marquee Slider",
      "blocks": [
        {"type": "text", "settings": {"text": "Express DELIVERY"}},
        {"type": "text", "settings": {"text": "FREE SHIPPING"}},
        {"type": "text", "settings": {"text": "COD AVAILABLE"}},
        {"type": "text", "settings": {"text": "EASY RETURNS"}}
      ]
    }
  ]
