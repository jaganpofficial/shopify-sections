{%- if section.blocks.size > 0 -%}
<div class="text-marquee-section" 
     data-section-animate="marquee-{{ section.id }}"
     style="background-color: {{ section.settings.background_color }}; 
            {%- if section.settings.background_image != blank -%}
            background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}');
            background-size: {{ section.settings.background_size }};
            background-position: {{ section.settings.background_position }};
            background-repeat: no-repeat;
            {%- endif -%}
            border-top: {{ section.settings.border_width }}px solid {{ section.settings.border_color }}; 
            border-bottom: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
            margin-top: {{ section.settings.margin_top }}px;">
  
  <div class="text-marquee-section__overlay" 
       style="opacity: {{ section.settings.background_overlay_opacity | divided_by: 100.0 }};"></div>
  
  <div class="page-width">
    <div class="marquee-slider">
      {%- for block in section.blocks -%}
        <div class="marquee-text-item {% if block.settings.image != blank %}has-image{% else %}text-only{% endif %} {% if forloop.first %}is-active{% endif %}" 
             data-index="{{ forloop.index0 }}"
             {{ block.shopify_attributes }}
             style="color: {{ section.settings.text_color }}">
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="marquee-link" style="color: {{ section.settings.text_color }}">
          {%- endif -%}
            <span class="marquee-content-wrapper">
              {%- if block.settings.image != blank -%}
                <span class="marquee-image-wrapper">
                  <img 
                    src="{{ block.settings.image | image_url: width: 300 }}" 
                    srcset="{{ block.settings.image | image_url: width: 150 }} 150w,
                            {{ block.settings.image | image_url: width: 300 }} 300w"
                    sizes="(max-width: 749px) {{ section.settings.image_size | times: 0.6 }}px, {{ section.settings.image_size }}px"
                    alt="{{ block.settings.text | escape }}"
                    loading="lazy"
                    width="{{ section.settings.image_size }}"
                    height="{{ section.settings.image_size }}"
                    class="marquee-image">
                </span>
              {%- endif -%}
              <span class="marquee-text">{{ block.settings.text }}</span>
            </span>
          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    
    <!-- Simple Progress Bar -->
    {%- if section.blocks.size > 1 -%}
      <div class="simple-progress-bar">
        {%- for block in section.blocks -%}
          <button class="progress-line {% if forloop.first %}active{% endif %}" 
                  data-progress="{{ forloop.index0 }}"
                  type="button"
                  aria-label="Go to slide {{ forloop.index }}">
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

<style>
/* === SLIDE UP ANIMATION ON SCROLL === */
.text-marquee-section {
  opacity: 0;
  transform: translateY(50px);
  transition: opacity 1s cubic-bezier(0.215, 0.61, 0.355, 1), 
              transform 1s cubic-bezier(0.215, 0.61, 0.355, 1);
  position: relative;
  width: 100%;
  padding: 0;
  text-align: center;
  overflow: hidden;
}

.text-marquee-section__overlay {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #000000;
  pointer-events: none;
  z-index: 1;
}

.text-marquee-section.animated {
  opacity: 1;
  transform: translateY(0);
}

.page-width {
  max-width: 100%;
  margin: 0;
  padding: 0;
  position: relative;
  z-index: 2;
}

/* === SLIDER CONTAINER WITH PROPER SPACING === */
.marquee-slider {
  position: relative;
  min-height: {{ section.settings.section_height }}px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: {{ section.settings.padding_top }}px 20px calc({{ section.settings.padding_bottom }}px + 50px);
}

/* === TEXT ITEMS - ULTRA CRISP & CLEAR === */
.marquee-text-item {
  position: absolute;
  width: 100%;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  opacity: 0;
  visibility: hidden; /* Changed logic here */
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  transition: none;
  will-change: opacity, left;
}

/* Text only adjustment */
.marquee-text-item.text-only {
  margin-top: calc({{ section.settings.font_size }}px / -2);
  padding: 0 20px;
}

/* With image adjustment */
.marquee-text-item.has-image {
  padding: 0 20px;
}

/* When active */
.marquee-text-item.is-active {
  opacity: 1 !important;
  visibility: visible !important;
  left: 0 !important;
  z-index: 2;
}

/* === CONTENT WRAPPER - VERTICAL LAYOUT === */
.marquee-content-wrapper {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: {{ section.settings.image_text_spacing }}px;
}

/* === IMAGE STYLING === */
.marquee-image-wrapper {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: {{ section.settings.image_size }}px;
  height: {{ section.settings.image_size }}px;
  border-radius: {{ section.settings.image_border_radius }}px;
  overflow: hidden;
  background: {{ section.settings.image_background }};
  border: {{ section.settings.image_border_width }}px solid {{ section.settings.image_border_color }};
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.marquee-image {
  width: 100%;
  height: 100%;
  object-fit: {{ section.settings.image_fit }};
  display: block;
}

/* === TEXT STYLING - CRYSTAL CLEAR === */
.marquee-text {
  font-size: {{ section.settings.font_size }}px;
  font-weight: {{ section.settings.font_weight }};
  line-height: 1.2;
  letter-spacing: {{ section.settings.letter_spacing }}px;
  text-transform: {{ section.settings.text_transform }};
  display: inline-block;
  font-style: {{ section.settings.font_style }};
  font-family: inherit;
  -webkit-font-smoothing: subpixel-antialiased;
  -moz-osx-font-smoothing: auto;
}

/* === ANIMATIONS === */
.marquee-text-item.slide-in-right {
  animation: slideInFromRight 0.8s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  visibility: visible;
  z-index: 3;
}

.marquee-text-item.slide-out-left {
  animation: slideOutToLeft 0.8s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  visibility: visible;
  z-index: 1;
}

@keyframes slideInFromRight {
  0% {
    left: 60%;
    opacity: 0;
  }
  100% {
    left: 0;
    opacity: 1;
  }
}

@keyframes slideOutToLeft {
  0% {
    left: 0;
    opacity: 1;
  }
  100% {
    left: -60%;
    opacity: 0;
  }
}

/* === LINK STYLING === */
.marquee-link {
  color: inherit !important;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  transition: opacity 0.3s ease;
}

.marquee-link:hover {
  opacity: 0.85;
}

/* === SIMPLE PROGRESS BAR - FIXED POSITION === */
.simple-progress-bar {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 8px;
  z-index: 10;
}

.progress-line {
  width: 40px;
  height: 3px;
  background: rgba(255, 255, 255, 0.3);
  display: block;
  border-radius: 2px;
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
  border: none;
  padding: 0;
  cursor: pointer;
}

.progress-line:hover {
  background: rgba(255, 255, 255, 0.5);
  transform: scaleY(1.3);
}

.progress-line::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 0%;
  height: 100%;
  background: #ffffff;
  border-radius: 2px;
}

.progress-line.active::after {
  width: 100%;
  transition: width {{ section.settings.pause_duration }}s linear;
}

/* === RESPONSIVE === */
@media screen and (max-width: 989px) {
  .marquee-slider {
    min-height: {{ section.settings.section_height | times: 0.8 | round: 0 }}px;
    padding: {{ section.settings.padding_top | times: 0.85 | round: 0 }}px 15px calc({{ section.settings.padding_bottom | times: 0.85 | round: 0 }}px + 45px);
  }
  
  .marquee-image-wrapper {
    width: {{ section.settings.image_size | times: 0.85 | round: 0 }}px;
    height: {{ section.settings.image_size | times: 0.85 | round: 0 }}px;
  }
  
  .marquee-text {
    font-size: {{ section.settings.font_size | times: 0.9 | round: 0 }}px;
  }
}

@media screen and (max-width: 749px) {
  .text-marquee-section {
    margin-top: {{ section.settings.margin_top | times: 0.6 | round: 0 }}px;
  }
  
  .marquee-slider {
    min-height: {{ section.settings.section_height | times: 0.6 | round: 0 }}px;
    padding: {{ section.settings.padding_top | times: 0.7 | round: 0 }}px 15px calc({{ section.settings.padding_bottom | times: 0.7 | round: 0 }}px + 40px);
  }
  
  .marquee-image-wrapper {
    width: {{ section.settings.image_size | times: 0.7 | round: 0 }}px;
    height: {{ section.settings.image_size | times: 0.7 | round: 0 }}px;
  }
  
  .marquee-text {
    font-size: {{ section.settings.font_size | times: 0.8 | round: 0 }}px;
  }
  
  .progress-line {
    width: 25px;
    height: 2px;
  }
}
</style>

<script>
(function() {
  'use strict';

  function init() {
    const section = document.querySelector('[data-section-animate="marquee-{{ section.id }}"]');
    if (!section) return;
    
    // Animate section on scroll
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animated');
          observer.disconnect();
        }
      });
    }, { threshold: 0.1 });
    observer.observe(section);

    initMarqueeSlider(section);
  }

  function initMarqueeSlider(section) {
    const items = section.querySelectorAll('.marquee-text-item');
    const bars = section.querySelectorAll('.progress-line');
    
    if (items.length < 2) return;

    let currentIndex = 0;
    let timer = null;
    let isTransitioning = false;
    const pauseTime = {{ section.settings.pause_duration | times: 1000 }};
    const transitionTime = 800; // Match CSS animation

    function resetSlider() {
      // Hard reset for when browser tab reactivates
      clearTimeout(timer);
      isTransitioning = false;
      
      items.forEach((item, index) => {
        item.classList.remove('slide-in-right', 'slide-out-left');
        item.style.animation = 'none'; // Stop any running animation
        item.offsetHeight; /* trigger reflow */
        item.style.animation = ''; 
        
        if (index === currentIndex) {
          item.classList.add('is-active');
          bars[index].classList.add('active');
        } else {
          item.classList.remove('is-active');
          bars[index].classList.remove('active');
        }
      });
      
      startTimer();
    }

    function goToSlide(nextIndex) {
      if (isTransitioning || nextIndex === currentIndex) return;
      isTransitioning = true;
      clearTimeout(timer);

      const currentItem = items[currentIndex];
      const nextItem = items[nextIndex];
      const currentBar = bars[currentIndex];
      const nextBar = bars[nextIndex];

      // Update Bars
      currentBar.classList.remove('active');
      nextBar.classList.add('active');

      // Animate Out Current
      currentItem.classList.add('slide-out-left');
      currentItem.classList.remove('is-active');

      // Animate In Next
      nextItem.classList.add('slide-in-right');
      
      // Cleanup after animation
      setTimeout(() => {
        currentItem.classList.remove('slide-out-left');
        nextItem.classList.remove('slide-in-right');
        nextItem.classList.add('is-active');
        
        currentIndex = nextIndex;
        isTransitioning = false;
        startTimer();
      }, transitionTime);
    }

    function startTimer() {
      clearTimeout(timer);
      timer = setTimeout(() => {
        const next = (currentIndex + 1) % items.length;
        goToSlide(next);
      }, pauseTime);
    }

    // Event Listeners for manual clicks
    bars.forEach((bar, idx) => {
      bar.addEventListener('click', () => goToSlide(idx));
    });

    // PAGE VISIBILITY API FIX
    // This detects when user leaves tab and forces a reset on return
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        clearTimeout(timer);
      } else {
        // Slight delay to ensure browser is ready to paint
        setTimeout(resetSlider, 100);
      }
    });

    // Start
    startTimer();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

{% schema %}
{
  "name": "Text Marquee Slider",
  "class": "section-text-marquee",
  "settings": [
    {
      "type": "header",
      "content": "Section Size"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 150,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Section Height",
      "default": 350
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "select",
      "id": "background_size",
      "label": "Background Size",
      "options": [
        {"value": "cover", "label": "Cover"},
        {"value": "contain", "label": "Contain"},
        {"value": "auto", "label": "Auto"}
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Background Position",
      "options": [
        {"value": "center center", "label": "Center"},
        {"value": "top center", "label": "Top"},
        {"value": "bottom center", "label": "Bottom"},
        {"value": "left center", "label": "Left"},
        {"value": "right center", "label": "Right"}
      ],
      "default": "center center"
    },
    {
      "type": "range",
      "id": "background_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background Overlay Opacity",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors & Borders"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#8B1538"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Border Width",
      "default": 1
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "range",
      "id": "image_size",
      "min": 40,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Image Size",
      "default": 90
    },
    {
      "type": "range",
      "id": "image_text_spacing",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Space Between Image & Text",
      "default": 20
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Image Border Radius",
      "default": 10
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Image Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "image_border_color",
      "label": "Image Border Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "image_border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Image Border Width",
      "default": 0
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image Fit",
      "options": [
        {"value": "contain", "label": "Contain"},
        {"value": "cover", "label": "Cover"}
      ],
      "default": "contain"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Font Size",
      "default": 48
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        {"value": "300", "label": "Light"},
        {"value": "400", "label": "Normal"},
        {"value": "500", "label": "Medium"},
