          <button class="action-btn js-drawer-toggle">
            <svg class="icon icon-md" viewBox="0 0 24 24"><path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z"/></svg>
          </button>
        </div>
      </div>

      <div class="mobile-bottom-row">
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-bar-mobile">
          <input type="text" name="q" class="search-input" placeholder="Search">
          <button type="submit" class="search-icon-btn">
            <svg class="icon" viewBox="0 0 24 24"><path d="M21.71 20.29L18 16.61A9 9 0 1 0 16.61 18l3.68 3.68a1 1 0 0 0 1.42 0 1 1 0 0 0 0-1.42zM11 18a7 7 0 1 1 7-7 7 7 0 0 1-7 7z"/></svg>
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Drawer Menu -->
  <div class="drawer-menu" id="DrawerMenu">
    <div class="drawer-overlay js-drawer-toggle"></div>
    <div class="drawer-content">
      <div class="drawer-header">
        <a href="/" class="header-logo">
          {%- liquid
            assign mobile_logo_image = section.settings.mobile_logo | default: section.settings.logo
            assign mobile_logo_width = section.settings.mobile_logo_width
            assign mobile_logo_width_2x = mobile_logo_width | times: 2
          -%}
          {% if mobile_logo_image != blank %}
            {{ mobile_logo_image | image_url: width: mobile_logo_width_2x | image_tag: width: mobile_logo_width, loading: 'lazy', alt: shop.name, style: 'height: auto; width: auto;' }}
          {% else %}
            <span class="header-logo-text">{{ shop.name }}</span>
          {% endif %}
        </a>
        <a href="{{ section.settings.instagram_url | default: '#' }}" class="action-btn" aria-label="Instagram">
          <svg class="icon icon-md" viewBox="0 0 24 24">
             <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
        <button class="action-btn js-drawer-toggle">
          <svg class="icon icon-md" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
        </button>
      </div>

      <div class="drawer-body">
        <div class="drawer-featured">
          {% for block in section.blocks %}
            {% if block.type == 'featured_item' %}
              {% liquid
                assign item_image = nil
                assign item_title = nil
                assign item_url = '#'

                if block.settings.item_source == 'product' and block.settings.product != blank
                  assign item_image = block.settings.product.featured_image
                  assign item_title = block.settings.product.title
                  assign item_url = block.settings.product.url
                elsif block.settings.item_source == 'collection' and block.settings.collection != blank
                  assign item_image = block.settings.collection.image
                  assign item_title = block.settings.collection.title
                  assign item_url = block.settings.collection.url
                else
                  assign item_image = block.settings.image
                  assign item_title = block.settings.title
                  assign item_url = block.settings.link
                endif
              %}
              <a href="{{ item_url | default: '#' }}" class="drawer-featured-item" {{ block.shopify_attributes }}>
                {% if item_image != blank %}
                  <img
                    src="{{ item_image | image_url: width: 400, height: 400, crop: 'center' }}"
                    alt="{{ item_title | escape }}"
                    class="drawer-featured-img"
                  >
                {% else %}
                  {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'drawer-featured-img' }}
                {% endif %}
                {% if item_title != blank %}
                  <div class="drawer-featured-title">{{ item_title }}</div>
                {% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>

        {% if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 %}
          <ul class="drawer-nav-list">
            {% for link in linklists[section.settings.menu].links %}
              <li class="drawer-nav-item">
                <a href="{{ link.url }}" class="drawer-nav-link">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const drawer = document.getElementById('DrawerMenu');
    const toggleBtns = document.querySelectorAll('.js-drawer-toggle');
    let isResizeScheduled = false;
    
    function setDrawerState(isOpen) {
      if (isOpen) {
        drawer.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      } else {
        drawer.classList.remove('is-open');
        document.body.style.overflow = '';
      }
      
      // Update ARIA attributes
      toggleBtns.forEach(btn => {
        btn.setAttribute('aria-expanded', isOpen);
      });
      drawer.setAttribute('aria-hidden', !isOpen);
    }

    function closeDrawer() {
      setDrawerState(false);
    }

    function openDrawer() {
      setDrawerState(true);
    }

    // Initialize ARIA
    closeDrawer();

    toggleBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        if (drawer.classList.contains('is-open')) {
          closeDrawer();
        } else {
          openDrawer();
        }
      });
    });

    // Optimized Resize Listener using requestAnimationFrame
    window.addEventListener('resize', function() {
      if (!isResizeScheduled) {
        window.requestAnimationFrame(function() {
          if (window.innerWidth >= 990 && drawer.classList.contains('is-open')) {
            closeDrawer();
          }
          isResizeScheduled = false;
        });
        isResizeScheduled = true;
      }
    }, { passive: true });

    // Accessibility: Close on Escape key
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape' && drawer.classList.contains('is-open')) {
        closeDrawer();
      }
    });
  });
</script>
