            <span class="header-logo-text">{{ shop.name }}</span>
          {% endif %}
        </a>
      </div>

      <div class="header-right">
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-bar-desktop">
          <input type="text" name="q" class="search-input" placeholder="Search">
          <button type="submit" class="search-icon-btn">
            <svg class="icon" viewBox="0 0 24 24"><path d="M21.71 20.29L18 16.61A9 9 0 1 0 16.61 18l3.68 3.68a1 1 0 0 0 1.42 0 1 1 0 0 0 0-1.42zM11 18a7 7 0 1 1 7-7 7 7 0 0 1-7 7z"/></svg>
          </button>
        </form>
        
        <a href="{{ routes.cart_url }}" class="action-btn" aria-label="Cart">
          <svg class="icon icon-md" viewBox="0 0 24 24"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
