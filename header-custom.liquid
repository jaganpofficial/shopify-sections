{% schema %}
{
  "name": "Custom Header",
  "tag": "header",
  "class": "section-header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Desktop Logo Image",
      "info": "Recommended dimensions: 300px width x 120px height (Max displayed height: 60px)"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 150,
      "unit": "px",
      "label": "Desktop Logo Width"
    },
    {
      "type": "header",
      "content": "Mobile Logo"
    },
    {
      "type": "image_picker",
      "id": "mobile_logo",
      "label": "Mobile Logo Image",
      "info": "Recommended dimensions: 200px width x 80px height"
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "min": 30,
      "max": 200,
      "step": 5,
      "default": 100,
      "unit": "px",
      "label": "Mobile Logo Width"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Contact Icons"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram Link"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Number",
      "info": "e.g., +1234567890"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "header_bg",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "header_text",
      "label": "Text Color",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "header_heading",
      "label": "Heading & Link Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "header_border",
      "label": "Border Color",
      "default": "#D8D6CF"
    },
    {
      "type": "color",
      "id": "header_accent",
      "label": "Accent Color",
      "default": "#E5611A"
    }
  ],
  "blocks": [
    {
      "type": "featured_item",
      "name": "Drawer featured item",
      "settings": [
        {
          "type": "select",
          "id": "item_source",
          "label": "Item source",
          "default": "product",
          "options": [
            {
              "value": "product",
              "label": "Product"
            },
            {
              "value": "collection",
              "label": "Collection"
            },
            {
              "value": "custom",
              "label": "Custom"
            }
          ]
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Header"
    }
  ]
}
{% endschema %}

{% style %}
  :root {
    --header-bg: {{ section.settings.header_bg }};
    --header-text: {{ section.settings.header_text }};
    --header-heading: {{ section.settings.header_heading }};
    --header-border: {{ section.settings.header_border }};
    --header-accent: {{ section.settings.header_accent }};
    --header-height-desktop: 80px;
    --header-height-mobile: auto;
  }

  .section-header {
    position: sticky;
    top: 0;
    z-index: 100000 !important;
  }

  .custom-header {
    background-color: var(--header-bg);
    color: var(--header-text);
    box-shadow: 0 1px 0 var(--header-border);
    font-family: 'Inter', sans-serif;
  }

  .header-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 20px;
    contain: layout style; /* CSS Containment for performance */
  }

  /* Icons */
  .icon {
    width: 20px;
    height: 20px;
    fill: currentColor;
    vertical-align: middle;
  }
  .icon-md {
    width: 24px;
    height: 24px;
  }

  /* Desktop Layout */
  .header-desktop {
    display: none; /* Hidden on mobile */
    height: var(--header-height-desktop);
    align-items: center;
    justify-content: space-between;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 25px;
    flex: 1;
  }

  .header-links {
    display: flex;
    gap: 24px;
  }

  .header-link {
    text-decoration: none;
    color: var(--header-heading);
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    font-family: 'Sora', 'Manrope', sans-serif;
    transition: color 0.2s;
  }

  .header-link:hover {
    color: var(--header-accent);
  }

  .header-center {
    flex: 0 0 auto;
    text-align: center;
  }

  .header-logo {
    display: block;
    line-height: 0;
  }

  .header-logo img {
    display: block;
    height: auto;
    max-height: 60px;
    object-fit: contain;
  }

  .header-logo-text {
    font-size: 24px;
    font-weight: 600;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--header-heading);
    letter-spacing: 0.5px;
    font-family: 'Sora', 'Manrope', sans-serif;
  }

  .header-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 20px;
    flex: 1;
  }

  .search-bar-desktop {
    position: relative;
    width: 280px;
  }

  .search-input {
    width: 100%;
    padding: 10px 40px 10px 16px;
    border-radius: 30px;
    border: 1px solid #0E1D3C;
    background-color: transparent;
    font-size: 14px;
    outline: none;
    transition: all 0.2s;
    color: var(--header-text);
    font-family: 'Inter', sans-serif;
  }

  .search-input:focus {
    background-color: transparent;
    border-color: #0E1D3C;
  }

  .search-icon-btn {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--header-text);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .action-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: var(--header-heading);
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    min-height: 40px;
    position: relative;
    transition: color 0.2s;
  }
  
  .action-btn:hover {
    color: var(--header-accent);
  }

  .cart-count-bubble {
    position: absolute;
    top: 4px;
    right: 4px;
    background-color: var(--header-accent);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    border-radius: 50%;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .whatsapp-btn {
    color: #25D366 !important;
  }

  /* Mobile Layout */
  .header-mobile {
    display: flex;
    flex-direction: column;
    padding: 12px 0;
    gap: 12px;
  }

  .mobile-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .mobile-left, .mobile-right {
    display: flex;
    gap: 8px;
    align-items: center;
    flex: 1;
  }

  .mobile-right {
    justify-content: flex-end;
  }

  .mobile-center {
    flex: 0 0 auto;
  }

  .search-bar-mobile {
    width: 100%;
    position: relative;
  }

  /* Drawer Menu */
  .drawer-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: 2147483647 !important;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.3s ease-out;
    will-change: opacity, visibility;
    pointer-events: none; /* Prevent interference when closed */
    overscroll-behavior: contain; /* Prevent scroll chaining */
  }

  .drawer-menu.is-open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  .drawer-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(2px);
  }

  .drawer-content {
    position: absolute;
    top: 0;
    right: 0;
    width: 85%;
    max-width: 400px;
    height: 100%;
    background: var(--header-bg);
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    display: flex;
    flex-direction: column;
    box-shadow: -2px 0 10px rgba(0,0,0,0.1);
    will-change: transform;
  }

  .drawer-menu.is-open .drawer-content {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid var(--header-border);
  }

  .drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
  }

  .drawer-featured {
    display: flex;
    flex-direction: row;
    gap: 16px;
    margin-bottom: 24px;
    overflow-x: auto;
    padding-bottom: 12px;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
    contain: content; /* Isolate layout/paint for scrolling area */
  }

  .drawer-featured::-webkit-scrollbar {
    height: 4px;
  }
  .drawer-featured::-webkit-scrollbar-track {
    background: transparent;
  }
  .drawer-featured::-webkit-scrollbar-thumb {
    background: var(--header-border);
    border-radius: 4px;
  }

  .drawer-featured-item {
    text-align: center;
    text-decoration: none;
    color: inherit;
    flex: 0 0 120px;
    min-width: 120px;
  }

  .drawer-featured-img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 8px;
    background: #f4f3ef;
  }

  .drawer-featured-title {
    font-weight: 500;
    font-size: 13px;
    font-family: 'Inter', sans-serif;
  }

  .drawer-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .drawer-nav-item {
    border-bottom: 1px solid var(--header-border);
  }

  .drawer-nav-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
    text-decoration: none;
    color: var(--header-heading);
    font-size: 16px;
    font-weight: 500;
    font-family: 'Sora', 'Manrope', sans-serif;
  }

  @media (min-width: 990px) {
    .header-desktop {
      display: flex;
    }
    .header-mobile {
      display: none;
    }
  }
{% endstyle %}

<div class="custom-header">
  <div class="header-container">
    
    <!-- Desktop Header -->
    <div class="header-desktop">
      <div class="header-left">
        <!-- Instagram -->
        <a href="{{ section.settings.instagram_url | default: '#' }}" class="action-btn" aria-label="Instagram">
          <svg class="icon icon-md" viewBox="0 0 24 24">
             <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
