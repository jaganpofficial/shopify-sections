<style>
  .avvsm-announcement-section {
    position: relative !important;
    z-index: 1 !important;
    width: 100%;
    background-color: {{ section.settings.background_color | default: '#ffffff' }};
    color: {{ section.settings.text_color | default: '#00035f' }};
    font-family: 'Inter', sans-serif;
  }

  .avvsm-announcement-bar {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 44px;
    padding: 6px 12px;
    overflow: hidden;
  }

  .scrolling-text-container {
    overflow: hidden;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .scrolling-text-track {
    display: flex;
    width: max-content;
    align-items: center;
    animation: scrolling-text {{ section.settings.marquee_speed }}s linear infinite;
  }

  .scrolling-text-group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    height: 100%;
  }

  @keyframes scrolling-text {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .avvsm-announcement-message {
    margin: 0;
    padding: 0 4rem;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: {{ section.settings.text_color | default: '#00035f' }};
  }

  .avvsm-announcement-link {
    color: {{ section.settings.text_color | default: '#00035f' }};
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .avvsm-announcement-link:hover {
    opacity: 0.85;
  }
  
</style>

{% if section.blocks.size > 0 %}
  <div class="avvsm-announcement-section">
    <div
      class="avvsm-announcement-bar"
      role="region"
      aria-label="{{ 'sections.header.announcement' | t }}"
    >
      <div class="scrolling-text-container">
        <div class="scrolling-text-track">
          {% capture announcement_content %}
            {%- for block in section.blocks -%}
              {%- if block.settings.text != blank -%}
                <p class="avvsm-announcement-message" {{ block.shopify_attributes }}>
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}" class="avvsm-announcement-link link link--text focus-inset">
                  {%- endif -%}
                    <span>{{ block.settings.text | escape }}</span>
                  {%- if block.settings.link != blank -%}
                    </a>
                  {%- endif -%}
                </p>
              {%- endif -%}
            {%- endfor -%}
          {% endcapture %}

          <div class="scrolling-text-group">
            {{ announcement_content }}
          </div>
          <div class="scrolling-text-group" aria-hidden="true">
            {{ announcement_content }}
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Marquee Announcement Bar",
  "max_blocks": 12,
  "class": "avvsm-announcement-section",
  "settings": [
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "s",
      "label": "Marquee Speed",
      "default": 40
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#00035f"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Add your announcement text here",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Announcement Bar",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
