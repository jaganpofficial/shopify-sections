{% stylesheet %}
.sus-wrapper {
  background: #faf7f2;
  padding: 60px 20px;
}

.sus-header {
  text-align: center;
  max-width: 900px;
  margin: 0 auto 40px;
}

.sus-header h2 {
  font-size: 34px;
  margin-bottom: 8px;
  font-weight: 600;
}

.sus-header p {
  color: #666;
  font-size: 15px;
}

.sus-slider {
  overflow: hidden;
  position: relative;
}

.sus-track {
  display: flex;
  gap: 24px;
  will-change: transform;
}

.sus-card {
  flex: 0 0 auto;
  width: 260px;
}

/* IMAGE */
.sus-img-wrap {
  width: 100%;
  aspect-ratio: 4 / 5;
  max-height: 380px;
  overflow: hidden;
  border-radius: 4px;
}

.sus-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* TEXT LIKE SCREENSHOT */
.sus-text {
  text-align: center;
}

.sus-text h4 {
  margin: 14px 0 6px;
  font-size: 15px;
  font-weight: 500;
  text-transform: lowercase;
}

.sus-text p {
  font-size: 13px;
  line-height: 1.6;
  color: #555;
  margin: 0 auto;
  max-width: 90%;
}


/* DESKTOP 4 CARDS */
@media (min-width: 768px) {
  .sus-card {
    width: calc(25% - 18px);
  }
}
{% endstylesheet %}

<section class="sus-wrapper">
  <div class="sus-header">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>

  <div class="sus-slider">
    <div class="sus-track" id="SusInfinite-{{ section.id }}">

      {% for block in section.blocks %}
        <div class="sus-card" {{ block.shopify_attributes }}>
          <div class="sus-img-wrap">
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 900 }}" alt="">
            {% endif %}
          </div>

          <div class="sus-text">
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.text }}</p>
          </div>
        </div>
      {% endfor %}

      {%- comment -%} duplicate for smooth loop {%- endcomment -%}
      {% for block in section.blocks %}
        <div class="sus-card">
          <div class="sus-img-wrap">
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 900 }}" alt="">
            {% endif %}
          </div>

          <div class="sus-text">
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.text }}</p>
          </div>
        </div>
      {% endfor %}

    </div>
  </div>
</section>

<script>
(function(){
  const track = document.getElementById("SusInfinite-{{ section.id }}");
  if(!track) return;

  let speed = 0.4; // adjust speed here
  let pos = 0;

  function animate() {
    pos -= speed;
    const halfWidth = track.scrollWidth / 2;

    if (Math.abs(pos) >= halfWidth) {
      pos = 0;
    }

    track.style.transform = `translateX(${pos}px)`;
    requestAnimationFrame(animate);
  }

  animate();
})();
</script>

{% schema %}
{
  "name": "Sustainability Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sustainability Pledge"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sub heading",
      "default": "At OOU, we're committed to transparency and sustainability, taking small steps towards a greener future"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Image Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "wear your values" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Short description goes here" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sustainability Slider",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
