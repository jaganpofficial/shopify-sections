<div class="mobile-collection-circles">
  <div class="collection-circles-wrapper">
    <div class="collection-circles-scroll">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.collection.url | default: '#' }}" 
           class="collection-circle-item"
           {{ block.shopify_attributes }}>
          <div class="circle-image-wrapper">
            {%- if block.settings.image != blank -%}
              {%- comment -%} USE CUSTOM IMAGE FIRST {%- endcomment -%}
              <img 
                src="{{ block.settings.image | image_url: width: 300 }}" 
                alt="{{ block.settings.title | default: 'Collection' | escape }}"
                loading="lazy"
                class="circle-image">
            {%- elsif block.settings.collection != blank and block.settings.collection.image -%}
              {%- comment -%} FALLBACK TO COLLECTION IMAGE {%- endcomment -%}
              <img 
                src="{{ block.settings.collection.image | image_url: width: 300 }}" 
                alt="{{ block.settings.title | default: block.settings.collection.title | escape }}"
                loading="lazy"
                class="circle-image">
            {%- else -%}
              {%- comment -%} PLACEHOLDER IF NO IMAGE {%- endcomment -%}
              <div class="circle-placeholder">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {%- endif -%}
          </div>
          {%- comment -%} ALWAYS USE CUSTOM TITLE, NEVER COLLECTION TITLE {%- endcomment -%}
          <span class="circle-title">
            {%- if block.settings.title != blank -%}
              {{ block.settings.title }}
            {%- else -%}
              {{ block.settings.collection.title | default: 'Untitled' }}
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
/* ============================================================
   BASE STYLES — Visible on ALL screen sizes
   ============================================================ */
.mobile-collection-circles {
  display: block;
  background: {{ section.settings.background_color }};
  padding: {{ section.settings.padding_vertical }}px 0;
  border-bottom: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
  position: relative;
  z-index: 1;
  margin-top: 0;
}

.collection-circles-wrapper {
  width: 100%;
  overflow: hidden;
  position: relative;
}

.collection-circles-scroll {
  display: flex;
  gap: {{ section.settings.item_gap }}px;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  scroll-behavior: smooth;
  scrollbar-width: none;
  -ms-overflow-style: none;
  padding: 0 {{ section.settings.side_padding }}px;
}

.collection-circles-scroll::-webkit-scrollbar {
  display: none;
}

/* === COLLECTION CIRCLE ITEM === */
.collection-circle-item {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: {{ section.settings.title_spacing }}px;
  text-decoration: none;
  transition: transform 0.3s ease;
  -webkit-tap-highlight-color: transparent;
  position: relative;
  z-index: 1;
}

.collection-circle-item:active {
  transform: scale(0.95);
}

/* === CIRCLE IMAGE === */
.circle-image-wrapper {
  width: {{ section.settings.circle_size }}px;
  height: {{ section.settings.circle_size }}px;
  border-radius: 50%;
  overflow: hidden;
  background: {{ section.settings.circle_background }};
  border: {{ section.settings.circle_border_width }}px solid {{ section.settings.circle_border_color }};
  box-shadow: {{ section.settings.circle_shadow }};
  position: relative;
  flex-shrink: 0;
}

.circle-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.circle-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f0;
}

.circle-placeholder svg {
  width: 60%;
  height: 60%;
  opacity: 0.3;
}

/* === CIRCLE TITLE === */
.circle-title {
  font-size: {{ section.settings.title_font_size }}px;
  font-weight: {{ section.settings.title_font_weight }};
  color: {{ section.settings.title_color }};
  text-align: center;
  line-height: 1.2;
  max-width: {{ section.settings.circle_size | plus: 20 }}px;
  display: block;
  text-transform: {{ section.settings.title_transform }};
  letter-spacing: 0.5px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  word-wrap: break-word;
}

/* ============================================================
   DESKTOP STYLES — above mobile breakpoint
   ============================================================ */
@media screen and (min-width: {{ section.settings.mobile_breakpoint | plus: 1 }}px) {
  .mobile-collection-circles {
    padding: {{ section.settings.desktop_padding_vertical }}px 0;
  }

  /* Centre the circles row and allow wrapping on desktop */
  .collection-circles-scroll {
    justify-content: {{ section.settings.desktop_alignment }};
    flex-wrap: {{ section.settings.desktop_wrap }};
    overflow-x: unset;          /* no horizontal scroll on desktop */
    padding: 0 {{ section.settings.desktop_side_padding }}px;
    gap: {{ section.settings.desktop_item_gap }}px;
  }

  /* Larger circles on desktop */
  .circle-image-wrapper {
    width: {{ section.settings.desktop_circle_size }}px;
    height: {{ section.settings.desktop_circle_size }}px;
  }

  /* Slightly larger title on desktop */
  .circle-title {
    font-size: {{ section.settings.desktop_title_font_size }}px;
    max-width: {{ section.settings.desktop_circle_size | plus: 20 }}px;
  }

  /* Subtle hover lift on desktop */
  .collection-circle-item:hover {
    transform: translateY(-4px);
  }

  .collection-circle-item:active {
    transform: scale(0.97);
  }
}

/* ============================================================
   MOBILE — below breakpoint (keep original compact sizing)
   ============================================================ */
@media screen and (max-width: {{ section.settings.mobile_breakpoint }}px) {
  /* Responsive sizes for very small phones */
  @media screen and (max-width: 480px) {
    .mobile-collection-circles {
      padding: {{ section.settings.padding_vertical | times: 0.8 | round: 0 }}px 0;
    }

    .circle-image-wrapper {
      width: {{ section.settings.circle_size | times: 0.9 | round: 0 }}px;
      height: {{ section.settings.circle_size | times: 0.9 | round: 0 }}px;
    }

    .circle-title {
      font-size: {{ section.settings.title_font_size | times: 0.9 | round: 0 }}px;
      max-width: {{ section.settings.circle_size | times: 0.9 | plus: 20 | round: 0 }}px;
    }

    .collection-circles-scroll {
      gap: {{ section.settings.item_gap | times: 0.8 | round: 0 }}px;
    }
  }
}
</style>

<script>
(function() {
  'use strict';

  // Touch-drag scroll enhancement — only needed on mobile
  if (window.innerWidth <= {{ section.settings.mobile_breakpoint }}) {
    const scrollContainer = document.querySelector('.collection-circles-scroll');
    
    if (scrollContainer) {
      let isScrolling = false;
      let startX;
      let scrollLeft;

      scrollContainer.addEventListener('touchstart', function(e) {
        isScrolling = true;
        startX = e.touches[0].pageX - scrollContainer.offsetLeft;
        scrollLeft = scrollContainer.scrollLeft;
      });

      scrollContainer.addEventListener('touchmove', function(e) {
        if (!isScrolling) return;
        e.preventDefault();
        const x = e.touches[0].pageX - scrollContainer.offsetLeft;
        const walk = (x - startX) * 2;
        scrollContainer.scrollLeft = scrollLeft - walk;
      });

      scrollContainer.addEventListener('touchend', function() {
        isScrolling = false;
      });
    }
  }
})();
</script>

